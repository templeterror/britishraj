# Local secrets for the FastAPI app. Copied to backend/.env by ./scripts/setup-env.sh
#
# Use the same Clerk development instance and the same Supabase project as
# frontend/.env.local. The secret key below bypasses row level security, so it
# stays on the server and is never given a NEXT_PUBLIC_ name.

APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Same values as the Next.js app, without the NEXT_PUBLIC_ prefix.
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# Clerk Dashboard → Supabase integration → Clerk domain.
# Example: happy-penguin-12.clerk.accounts.dev
# The API verifies session tokens at https://<this-domain>/.well-known/jwks.json
CLERK_DOMAIN=REPLACE_ME.clerk.accounts.dev

# Same project URL and publishable key as the frontend.
SUPABASE_URL=https://REPLACE_ME.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_ME

# Supabase Dashboard → Project Settings → API Keys → Secret key
# (formerly the service_role key). Backend only.
SUPABASE_SECRET_KEY=REPLACE_ME

# Optional. Needed only for `python -m app.market.cli analyze`.
# Create a key in the Vercel AI Gateway dashboard. Never commit the value.
# Leave the model lines empty to use the defaults: Grok 4.7 reads the words,
# GPT-5.5 writes the report, both at high thinking effort.
AI_GATEWAY_API_KEY=
AGENT_TRIAGE_MODEL=
AGENT_ANALYST_MODEL=
