# Local secrets for the Next.js app. Copied to frontend/.env.local by ./scripts/setup-env.sh
#
# Both developers use the SAME Clerk development instance and the SAME Supabase
# project. Share the values in a password manager. Do not commit .env.local,
# and do not paste production keys (pk_live_ / sk_live_).
#
# Clerk authenticates the user. Supabase trusts that Clerk session, so row
# level security runs as the signed-in Clerk user. There is no second Supabase
# sign-in.

# Clerk Dashboard → API keys → Publishable key (development).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Clerk Dashboard → API keys → Secret key (development). Server only.
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# Supabase Dashboard → Project Settings → Data API.
# Base URL only, for example https://abcdefgh.supabase.co — no /rest/v1 suffix.
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_ME.supabase.co

# Supabase Dashboard → Project Settings → API Keys → Publishable key
# (formerly the anon key). Safe to expose in the browser.
# Never put the secret key in this file.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_ME
